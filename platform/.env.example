# ---- core ----
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:pass@host:5432/kirmi
PUBLIC_BASE_URL=https://ops.kirmistudio.com
SESSION_SECRET=<64 random hex chars>

# ---- WhatsApp (Meta Cloud API) — required for a real number ----
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---- Instagram Messaging ----
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=

# ---- Telephony / missed-call recovery ----
VOICE_PROVIDER=none
VOICE_WEBHOOK_SECRET=

# ---- Payments ----
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Conversation model ----
LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
