# ---------------------------------------------------------------------------
# Kirmi Core Engine - environment template
#
# Rule of thumb for this file: environment variables hold PLATFORM secrets, the
# ones that belong to Kirmi Studio and are identical for every client. Anything
# that belongs to a CLIENT (their Meta app secret, their WhatsApp number, their
# opening hours, their VAT rate, their fee deal) lives in the database, in the
# Client and ClientConfiguration tables. That is what makes onboarding a new
# client a row insert instead of a deploy.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public base URL of this service. Twilio signs the exact URL it called, so if
# you sit behind a proxy this must be the URL the outside world used.
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
# The APPLICATION role. It must NOT be a superuser and must NOT hold BYPASSRLS,
# otherwise row level security silently stops applying and tenants can see each
# other. `npm run db:roles` provisions a correct pair of roles for you.
DATABASE_URL=postgresql://kirmi_app:change_me@localhost:5432/kirmi?schema=public

# The MIGRATION role. Owns the tables, runs `prisma migrate deploy`. Separate
# from the app role on purpose: the owner is the only one allowed to change
# shape, and FORCE ROW LEVEL SECURITY keeps even the owner inside its tenant.
MIGRATION_DATABASE_URL=postgresql://kirmi_migrate:change_me@localhost:5432/kirmi?schema=public

# Connection pool sizing for the app role.
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=8000

# --- Redis -----------------------------------------------------------------
# Two logical uses, one server: the hot conversation context cache (so a reply
# does not wait on Postgres) and the BullMQ queues.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=kirmi

# --- Latency budget --------------------------------------------------------
# The promise to the client is a reply inside 15 seconds. The pipeline measures
# itself against this and raises a breach event rather than quietly running slow.
REPLY_SLA_MS=15000
# Internal soft target for the cached path. Exceeding it is a warning, not a breach.
REPLY_TARGET_MS=3000

# --- Idempotency and holds -------------------------------------------------
# How long a seen webhook id is remembered. Meta retries for a while, so this
# needs to comfortably outlive their retry window.
IDEMPOTENCY_TTL_SECONDS=86400
# How long an unconfirmed vehicle hold survives before the sweeper releases it.
DEFAULT_HOLD_TTL_MINUTES=30

# --- Platform level integration keys ---------------------------------------
# The LLM used for parsing and extraction only. It never prices and never books.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_MS=6000

# Fallback verification secrets, used ONLY when a client row has none of its own.
# In production every client carries its own, and these stay blank.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=

# --- Secrets at rest -------------------------------------------------------
# 32 byte key, base64 encoded, used to encrypt per client credentials stored in
# ClientConfiguration. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# --- Human inbox (WebSocket) -----------------------------------------------
# Shared secret the dashboard presents when it opens the socket.
DASHBOARD_API_KEY=
# Comma separated origins allowed to call the metrics API and open the socket.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3001
