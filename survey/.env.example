# ---- core ----
PORT=3100
COOKIE_SECRET=<32+ random hex chars>
ADMIN_PASSWORD=<pick something you will actually remember>

# ---- storage ----
# Leave both blank for local testing: data goes in ./data/survey.db on disk, which is
# fine on your own machine but will NOT survive a redeploy or restart on most free
# hosts. For a real deployment, create a free database at turso.tech and paste its
# values here, same code either way.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---- adaptive follow-up questions ----
# Set GROQ_API_KEY to get real adaptive follow-ups (free, from console.groq.com).
# Leave everything below blank to run in deterministic mode instead: fixed follow-ups,
# no API calls, good for testing. If a Groq call ever fails mid-survey, it falls back
# to deterministic mode for that one turn rather than breaking the respondent's flow.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic is also supported (paid, no free tier) if you ever want Claude's follow-ups
# specifically. Leave blank unless you're using this instead of Groq.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
